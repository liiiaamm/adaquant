# Copy to .env and fill in. Never commit the real values.
AWS_REGION=eu-south-2
ADAQUANT_BUCKET=adaquant-data-bucket

# Kafka broker (SASL_PLAINTEXT + PLAIN)
KAFKA_BOOTSTRAP_SERVERS=<broker-host>:9092
KAFKA_USERNAME=<kafka-user>
KAFKA_PASSWORD=<kafka-password>

# Glue crawler role used by tests/test_glue.py
GLUE_ROLE_ARN=arn:aws:iam::<account-id>:role/service-role/<glue-role>
